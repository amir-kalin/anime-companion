# Local services only. There are no API keys in this project.
# Copy to .env and adjust if your ports/models differ.

# --- LM Studio (OpenAI-compatible server, load the model first)
# https://lmstudio.ai
LMSTUDIO_URL=http://127.0.0.1:1234/v1
# Must match a model id from GET $LMSTUDIO_URL/models
LM_MODEL=prism-ml/bonsai-27b
# LM Studio ignores this, but the OpenAI request shape wants a bearer token.
LMSTUDIO_API_KEY=lm-studio

# --- Voice service (voice/local_voice.py)
#   TTS: Piper ONNX voice
#   STT: faster-whisper (ctranslate2 CUDA if available, else CPU int8)
VOICE_URL=http://127.0.0.1:4123
